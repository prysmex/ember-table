{
  "name": "ember-table",
  "version": "6.0.0-12",
  "description": "An addon to support large data set and a number of features around table.",
  "keywords": [
    "ember-addon"
  ],
  "license": "BSD-3-Clause",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "https://github.com/Addepar/ember-table",
  "scripts": {
    "build": "ember build --environment=production",
    "docs:deploy": "ember try:one ember-default-docs --- ember deploy production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:hbs\" \"npm:lint:js\" --names \"lint:\" --prefixColors auto",
    "lint:files": "ls-lint",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:format": "prettier . --cache --check",
    "lint:sass": "concurrently \"yarn:lint:sass:*\"",
    "lint:sass:sass-lint": "sass-lint -c .sass-lint.yml --verbose --no-exit",
    "lint:sass:prettier": "prettier --list-different '{addon,app}/styles/**/*.scss' 'tests/dummy/app/styles/**/*.scss'",
    "release": "release-it",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:ember\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "dependencies": {
    "@babel/core": "^7.0.0-0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.12.13",
    "@babel/plugin-proposal-numeric-separator": "^7.12.13",
    "@babel/plugin-proposal-object-rest-spread": "^7.12.13",
    "@babel/plugin-proposal-optional-catch-binding": "^7.12.13",
    "@babel/plugin-proposal-optional-chaining": "^7.12.13",
    "@html-next/vertical-collection": "^5.0.0",
    "@ember/render-modifiers": "^4.0.0",
    "css-element-queries": "^0.4.0",
    "ember-auto-import": "^2.4.2",
    "ember-classy-page-object": "^0.8.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-node-assets": "^0.2.2",
    "ember-cli-version-checker": "^5.1.2",
    "ember-compatibility-helpers": "^1.2.6",
    "ember-raf-scheduler": "^0.5.0",
    "ember-test-selectors": "^7.1.0",
    "hammerjs": "^2.0.8",
    "ember-template-imports": "^4.4.0"
  },
  "devDependencies": {
    "@addepar/style-toolbox": "~0.8.1",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@ember/string": "^3.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/test-setup": "^4.0.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@embroider/macros": "^1.21.1",
    "@eslint/js": "^9.39.5",
    "@ls-lint/ls-lint": "^2.2.3",
    "@tsconfig/ember": "^1.0.1",
    "@types/ember__component": "^4.0.10",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.1.2",
    "ember-a11y-testing": "^8.0.1",
    "ember-cli": "~7.3.0",
    "ember-cli-dependency-checker": "^3.2.0",
    "ember-cli-inject-live-reload": "^2.0.1",
    "ember-cli-sass": "^10.0.0",
    "ember-cli-sri": "^2.1.0",
    "ember-cli-terser": "^4.0.0",
    "ember-disable-prototype-extensions": "^1.1.2",
    "ember-faker": "^2.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-math-helpers": "~2.11.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^6.1.0",
    "ember-truth-helpers": "^3.0.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^15.15.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "release-it": "^15.5.0",
    "sass": "^1.26.10",
    "sass-lint": "^1.13.1",
    "typescript": "^4.8.4",
    "webpack": "^5.0.0"
  },
  "peerDependencies": {
    "ember-source": ">= 5.12.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  },
  "homepage": "https://Addepar.github.io/ember-table",
  "typesVersions": {
    "*": {
      "*": [
        "types/*"
      ]
    }
  },
  "packageManager": "npm@10.9.3"
}
