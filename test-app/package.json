{
  "name": "test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Test and documentation app for ember-table",
  "repository": "",
  "license": "BSD-3-Clause",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "vite build --mode development && testem ci --port 0"
  },
  "dependencies": {
    "ember-table": "workspace:*"
  },
  "devDependencies": {
    "@addepar/style-toolbox": "~0.8.1",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/runtime": "^7.29.7",
    "@docfy/core": "^0.14.2",
    "@docfy/ember": "^0.14.2",
    "@docfy/ember-vite": "^0.14.2",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.3",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "axe-core": "^4.11.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "decorator-transforms": "^2.4.0",
    "ember-a11y-testing": "^8.0.1",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "sass": "^1.93.0",
    "testem": "^3.21.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  }
}
